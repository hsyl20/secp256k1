cabal-version: 3.0
name:          secp256k1-clib
version:       0.7.1
synopsis:       High-performance high-assurance C library for digital signatures and other cryptographic primitives on the secp256k1 elliptic curve.
description:   libsecp256k1. See [secp256k1](https://github.com/bitcoin-core/secp256k1)
category:      Cryptography
license:       MIT
license-file:  COPYING
build-type:    Simple

extra-source-files:
  src/modules/ecdh/main_impl.h
  src/modules/recovery/main_impl.h
  src/modules/musig/main_impl.h
  src/modules/musig/keyagg.h
  src/modules/musig/keyagg_impl.h
  src/modules/musig/session.h
  src/modules/musig/session_impl.h
  src/modules/ellswift/main_impl.h
  src/modules/extrakeys//main_impl.h
  src/modules/schnorrsig/main_impl.h
  include/secp256k1_preallocated.h
  src/assumptions.h
  src/bench.h
  src/checkmem.h
  src/ecdsa.h
  src/ecdsa_impl.h
  src/eckey.h
  src/eckey_impl.h
  src/ecmult_compute_table.h
  src/ecmult_compute_table_impl.h
  src/ecmult_const.h
  src/ecmult_const_impl.h
  src/ecmult_gen_compute_table.h
  src/ecmult_gen_compute_table_impl.h
  src/ecmult_gen.h
  src/ecmult_gen_impl.h
  src/ecmult.h
  src/ecmult_impl.h
  src/field_10x26.h
  src/field_10x26_impl.h
  src/field_5x52.h
  src/field_5x52_impl.h
  src/field_5x52_int128_impl.h
  src/field.h
  src/field_impl.h
  src/group.h
  src/group_impl.h
  src/hash.h
  src/hash_impl.h
  src/hsort.h
  src/hsort_impl.h
  src/int128.h
  src/int128_impl.h
  src/int128_native.h
  src/int128_native_impl.h
  src/int128_struct.h
  src/int128_struct_impl.h
  src/modinv32.h
  src/modinv32_impl.h
  src/modinv64.h
  src/modinv64_impl.h
  src/precomputed_ecmult_gen.h
  src/precomputed_ecmult.h
  src/scalar_4x64.h
  src/scalar_4x64_impl.h
  src/scalar_8x32.h
  src/scalar_8x32_impl.h
  src/scalar.h
  src/scalar_impl.h
  src/scalar_low.h
  src/scalar_low_impl.h
  src/scratch.h
  src/scratch_impl.h
  src/selftest.h
  src/testrand.h
  src/testrand_impl.h
  src/tests_common.h
  src/testutil.h
  src/unit_test.h
  src/util.h
  src/util_local_visibility.h

flag ecdh
  description: Enable ECDH module
  default: False
  manual: True

flag recovery
  description: Enable RECOVERY module
  default: False
  manual: True

flag schnorrsig
  description: Enable SCHNORRSIG module
  default: False
  manual: True

flag musig
  description: Enable MuSig2 module
  default: False
  manual: True

flag ellswift
  description: Enable ElligatorSwift
  default: False
  manual: True

flag extrakeys
  description: Enable EXTRAKEYS module
  default: False
  manual: True

library
    default-language: Haskell2010
    c-sources:
      src/secp256k1.c
      src/precomputed_ecmult.c
      src/precomputed_ecmult_gen.c

    cc-options: -O2

    include-dirs: include
    install-includes: secp256k1.h

    -- TODO: support ARM asm

    if flag(ecdh)
      install-includes: secp256k1_ecdh.h
      cc-options: -DENABLE_MODULE_ECDH

    if flag(ellswift)
      install-includes: secp256k1_ellswift.h
      cc-options: -DENABLE_MODULE_ELLSWIFT

    if flag(extrakeys)
      install-includes: secp256k1_extrakeys.h
      cc-options: -DENABLE_MODULE_EXTRAKEYS

    if flag(musig)
      install-includes: secp256k1_musig.h
      cc-options: -DENABLE_MODULE_MUSIG

    if flag(recovery)
      install-includes: secp256k1_recovery.h
      cc-options: -DENABLE_MODULE_RECOVERY

    if flag(schnorrsig)
      install-includes: secp256k1_schnorrsig.h
      cc-options: -DENABLE_MODULE_SCHNORRSIG
